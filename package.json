{
  "name": "transconnect-management-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test tests/api.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write src tests *.ts *.js *.json",
    "format:check": "prettier --check src tests *.ts *.js *.json",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.71.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
