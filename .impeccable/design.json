      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:8px;font-family:Inter,'Segoe UI',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:background-color .16s ease,color .16s ease;background:var(--brand-primary,#d3171e);color:#fff;}.ds-primary:hover{background:var(--brand-hover,#ad1117)}.ds-primary:focus-visible{outline:3px solid var(--focus,#a30f16);outline-offset:3px;}.ds-primary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary Button action with visible keyboard focus.",
      "html": "<button type=\"button\" class=\"ds-secondary\">Làm mới</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:8px;font-family:Inter,'Segoe UI',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:background-color .16s ease,color .16s ease;background:#fff;color:#333d4a;border-color:#dce0e6;}.ds-secondary:hover{background:#f0f2f5;border-color:#bbc3ce}.ds-secondary:focus-visible{outline:3px solid var(--focus,#a30f16);outline-offset:3px;}.ds-secondary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Outlined Rejection",
      "kind": "button",
      "refersTo": "button-danger-outline",
      "description": "Outlined Rejection action with visible keyboard focus.",
      "html": "<button type=\"button\" class=\"ds-danger-outline\">Từ chối</button>",
      "css": ".ds-danger-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:8px;font-family:Inter,'Segoe UI',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:background-color .16s ease,color .16s ease;background:#fff;color:#b21218;border-color:#efb8bb;}.ds-danger-outline:hover{background:#fff3f3}.ds-danger-outline:focus-visible{outline:3px solid var(--focus,#a30f16);outline-offset:3px;}.ds-danger-outline:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-danger-outline{transition:none}}"
    },
    {
      "name": "Labeled Field",
      "kind": "input",
      "refersTo": "filter-input",
      "description": "Warm labeled list filter with visible focus and readable mobile input.",
      "html": "<label class=\"ds-field\">Tên đơn vị<input placeholder=\"Nhập tên đơn vị\" /></label>",
      "css": ".ds-field{display:grid;gap:7px;font-family:Inter,'Segoe UI',sans-serif;font-size:13px;font-weight:600;color:#414b58}.ds-field input{width:100%;min-height:46px;padding:10px 12px;border:1px solid #cbd1d9;border-radius:8px;background:#fff;color:var(--text-primary,#242824);font-family:Inter,'Segoe UI',sans-serif;font-size:14px;font-weight:400}.ds-field input::placeholder{color:#697382}.ds-field input:hover{border-color:#a4adb9}.ds-field input:focus{border-color:var(--brand-primary,#d3171e)}.ds-field input:focus-visible{outline:3px solid var(--focus,#a30f16);outline-offset:3px;}@media(max-width:760px){.ds-field input{font-size:16px}}"
    },
    {
      "name": "Current Destination",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "Current destination in the white desktop horizontal row; mobile uses a charcoal drawer.",
      "html": "<nav class=\"ds-destinations\" aria-label=\"Quản lý\"><a class=\"ds-current\" href=\"#organizations\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 21V5l8-3 8 3v16M2 21h20M8 8h1m6 0h1M8 12h1m6 0h1M10 21v-5h4v5\"/></svg>Đơn vị vận tải</a></nav>",
      "css": ".ds-destinations{display:flex;align-items:center;gap:12px;min-height:72px;padding:0 28px;background:var(--surface-panel,#fff);border-bottom:1px solid var(--line,#e3e6de)}.ds-current{display:inline-flex;align-items:center;gap:9px;min-height:44px;padding:12px 18px;border-radius:8px;background:var(--brand-primary,#d3171e);color:#fff;font-family:Inter,'Segoe UI',sans-serif;font-size:13px;font-weight:600;text-decoration:none;transition:background-color .16s ease,color .16s ease}.ds-current svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-current:hover{background:var(--brand-hover,#ad1117)}.ds-current:focus-visible{outline:3px solid var(--brand-hover,#ad1117);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-current{transition:none}}"
    },
    {
      "name": "Pending Status",
      "kind": "chip",
      "refersTo": "status-pending",
      "description": "Noninteractive status with readable label and dot.",
      "html": "<span class=\"ds-pending\"><span aria-hidden=\"true\"></span>Chờ duyệt</span>",
      "css": ".ds-pending{display:inline-flex;align-items:center;gap:7px;padding:5px 10px;border:1px solid #f5dfac;border-radius:5px;background:#fff8e7;color:#826014;font-family:Inter,'Segoe UI',sans-serif;font-size:13px;font-weight:600;white-space:nowrap}.ds-pending>span{width:5px;height:5px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Approved Status",
      "kind": "chip",
      "refersTo": "status-approved",
      "description": "Noninteractive status with readable label and dot.",
      "html": "<span class=\"ds-approved\"><span aria-hidden=\"true\"></span>Đã duyệt</span>",
      "css": ".ds-approved{display:inline-flex;align-items:center;gap:7px;padding:5px 10px;border:1px solid #c5e6d3;border-radius:5px;background:#edf8f1;color:#247347;font-family:Inter,'Segoe UI',sans-serif;font-size:13px;font-weight:600;white-space:nowrap}.ds-approved>span{width:5px;height:5px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Rejected Status",
      "kind": "chip",
      "refersTo": "status-rejected",
      "description": "Noninteractive status with readable label and dot.",
      "html": "<span class=\"ds-rejected\"><span aria-hidden=\"true\"></span>Từ chối</span>",
      "css": ".ds-rejected{display:inline-flex;align-items:center;gap:7px;padding:5px 10px;border:1px solid #f2cdd0;border-radius:5px;background:#fdefef;color:#a72732;font-family:Inter,'Segoe UI',sans-serif;font-size:13px;font-weight:600;white-space:nowrap}.ds-rejected>span{width:5px;height:5px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Work Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat bordered surface used for information and review.",
      "html": "<section class=\"ds-panel\"><h2>Thông tin đăng ký</h2><p>Thông tin hồ sơ và trạng thái xét duyệt.</p></section>",
      "css": ".ds-panel{padding:28px;border:1px solid #e1e5dc;border-radius:14px;background:var(--surface-panel,#fff);box-shadow:none;color:var(--text-primary,#242824);font-family:Inter,'Segoe UI',sans-serif;}.ds-panel h2{margin:0 0 6px;font-size:21px;font-weight:600;letter-spacing:-.02em}.ds-panel p{margin:0;font-size:14px;line-height:1.55;color:var(--text-secondary,#626963)}"
    },
    {
      "name": "Record Identity",
      "kind": "custom",
      "refersTo": "entity-initial",
      "description": "Initial badge with primary name and supporting record metadata.",
      "html": "<div class=\"ds-entity\"><span class=\"ds-initial\" aria-hidden=\"true\">V</span><div><a class=\"ds-name\" href=\"#record\">Đơn vị vận tải</a><small>Mã đăng ký: …</small></div></div>",
      "css": ".ds-entity{display:flex;align-items:center;gap:14px;font-family:Inter,'Segoe UI',sans-serif;}.ds-initial{display:grid;place-items:center;flex:none;width:42px;height:42px;background:#fafafb;border:1px solid #e3e5e8;border-radius:9px;font-size:15px;font-weight:600;color:#626963}.ds-name{color:#26313f;font-size:14px;line-height:1.5;font-weight:600;text-decoration:none}.ds-name:hover{color:var(--brand-primary,#d3171e)}.ds-name:focus-visible{outline:3px solid var(--focus,#a30f16);outline-offset:3px;}.ds-entity small{display:block;margin-top:5px;font-size:13px;line-height:1.6;color:#6c7684}"
    },
    {
      "name": "Sysadmin Account Select",
      "kind": "input",
      "refersTo": "auth-account-select",
      "description": "Styled native Admin account selector labeled Tài khoản. Shows Sysadmin by default with its email hidden from presentation; Developer, Data engineer and Accountant have no configured email and cannot submit. The application includes a person icon and a custom chevron. Partner entry uses a business email field.",
      "html": "<label class=\"ds-auth-label\">Tài khoản<select class=\"ds-auth-select\" autocomplete=\"username\" required><option value=\"sysadmin\" selected>Sysadmin</option><option value=\"developer\">Developer</option><option value=\"data-engineer\">Data engineer</option><option value=\"accountant\">Accountant</option></select></label>",
      "css": ".ds-auth-label{display:grid;gap:7px;font-family:Inter,'Segoe UI',sans-serif;font-size:13px;font-weight:600;color:var(--text-primary,#242824)}.ds-auth-select{width:100%;min-height:50px;padding:10px 12px;border:1px solid #cbd1d9;border-radius:8px;background:#fff;color:var(--text-primary,#242824);font-family:Inter,'Segoe UI',sans-serif;font-size:15px;font-weight:400;caret-color:var(--red-dark,#ad1117)}.ds-auth-select:hover{border-color:#a4adb9}.ds-auth-select:focus{border-color:var(--red,#d3171e)}.ds-auth-select:focus-visible{outline:3px solid var(--focus,#a30f16);outline-offset:3px}.ds-auth-select[aria-invalid=\"true\"]{border-color:var(--red-dark,#ad1117)}.ds-auth-select:disabled{opacity:.48;cursor:not-allowed}@media(max-width:760px){.ds-auth-select{font-size:16px}}"
    }
  ],
  "narrative": {
    "northStar": "Swiss transport wayfinding",
    "overview": "Clear destinations, aligned records and restrained surfaces define this Management application. A full-width crimson brand header and white horizontal destination row introduce a neutral, light workspace. Compact task headings and readable records make identity, status and next actions easy to scan; gold provides brand punctuation.\n\nThis is the implemented Management system. It complements the shared [VieGo cross-platform design guidance](../../TransConnect-Docs/06-ui/VIEGO_DESIGN_SYSTEM.md), which retains brand and business authority. The user-selected horizontal composition supersedes the earlier desktop rail while preserving the established list-to-detail workflow.",
    "keyCharacteristics": [
      "Crimson brand header and white horizontal destinations on desktop.",
      "Neutral work surfaces, readable records and a clear task hierarchy.",
      "Flat bordered panels, restrained corners and labeled semantic statuses.",
      "Local Vietnamese Inter typography and inline SVG control icons.",
      "Charcoal navigation retained only as the mobile drawer."
    ],
    "rules": [
      {
        "name": "The Destination Rule",
        "body": "Exactly one route-driven current destination uses the solid crimson tile and white label, synchronized with aria-current; desktop destinations sit in the white horizontal row.",
        "section": "colors"
      },
      {
        "name": "The Brand Continuity Rule",
        "body": "Retain the established crimson and gold roles when extending Management.",
        "section": "colors"
      },
      {
        "name": "The Flat Work Surface Rule",
        "body": "Keep resting work panels shadowless; use borders and surface tones to group information.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the crimson header, white desktop destination row and gold brand punctuation.",
      "Do keep exactly one route-driven current destination.",
      "Do use local Inter assets and SVG control icons.",
      "Do preserve visible keyboard focus, labeled statuses and mobile record reflow.",
      "Do place detail information and review ahead of secondary history."
    ],
    "donts": [
      "Don't restore a permanent desktop rail within the approved horizontal shell.",
      "Don't add resting shadows to ordinary work panels.",
      "Don't replace status labels with color alone.",
      "Don't treat fixture screenshots as evidence of live backend acceptance.",
      "Don't promote legacy decorative labels into a reusable heading pattern."
    ]
  }
}
